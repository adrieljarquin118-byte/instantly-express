# Copia este archivo como web/.env y coloca tu clave real de Google Maps.
# Sin clave la app muestra el mapa de respaldo (OpenStreetMap), no falla.
VITE_GOOGLE_MAPS_API_KEY=tu_clave_de_google_maps_aqui

# Opcional: URL del backend si no usas el valor por defecto de produccion.
# VITE_API_URL=https://instantly-express-production.up.railway.app/api
